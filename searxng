FROM searxng/searxng:latest

# 1. 设置只读环境下的可写配置路径
ENV SEARXNG_SETTINGS_PATH=/tmp/searxng/settings.yml
ENV SEARXNG_LIMITER=false

# 2. 暴露 Hostless 要求的端口
ENV SEARXNG_PORT=8000
ENV SEARXNG_BIND_ADDRESS=0.0.0.0
EXPOSE 8000

# 3. 构建时将默认配置复制到可写目录
RUN mkdir -p /tmp/searxng && \
    cp /usr/local/searxng/searx/settings.yml /tmp/searxng/settings.yml

# 4. 删除官方启动脚本（避免它尝试修改 /etc 权限）
ENTRYPOINT []

# 5. 直接使用官方虚拟环境中的 Python 启动
CMD ["/usr/local/searxng/searxng-venv/bin/python", "/usr/local/searxng/searx/webapp.py"]
